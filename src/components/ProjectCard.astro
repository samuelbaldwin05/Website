---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  index: number;
}

const { project, index } = Astro.props;
const { title, description, tags, github, link } = project.data;
const number = String(index + 1).padStart(2, "0");
---

<article
  class="project-card fade-up"
  style={`--stagger:${(index * 0.06).toFixed(2)}s`}
>
  <div class="project-card-head">
    <span class="project-index">{number}</span>
    {link && (
      <span class="project-live">
        <span class="project-live-dot" aria-hidden="true"></span>
        Live
      </span>
    )}
  </div>

  <h2 class="project-title">{title}</h2>
  <p class="project-desc">{description}</p>

  {tags.length > 0 && (
    <ul class="project-tags" aria-label="Tech stack">
      {tags.map((tag) => (
        <li class="project-tag">{tag}</li>
      ))}
    </ul>
  )}

  <div class="project-links">
    {github && (
      <a href={github} target="_blank" rel="noopener noreferrer" class="project-link">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2a9.75 9.75 0 0 0-3.08 19c.49.09.67-.21.67-.47 0-.23-.01-.84-.01-1.64-2.45.45-2.96-1.18-2.96-1.18-.45-1.15-1.1-1.46-1.1-1.46-.9-.61.07-.6.07-.6 1 .07 1.53 1.04 1.53 1.04.89 1.54 2.34 1.1 2.91.84.09-.66.35-1.1.63-1.35-1.96-.23-4.02-.98-4.02-4.37 0-.97.35-1.76.93-2.38-.09-.23-.4-1.16.09-2.41 0 0 .74-.24 2.43.91a8.3 8.3 0 0 1 4.42 0c1.69-1.15 2.43-.91 2.43-.91.49 1.25.18 2.18.09 2.41.58.62.93 1.41.93 2.38 0 3.4-2.06 4.13-4.02 4.35.36.31.68.92.68 1.86 0 1.35-.01 2.44-.01 2.77 0 .26.18.57.68.47A9.75 9.75 0 0 0 12 2z"/>
        </svg>
        GitHub
      </a>
    )}
    {link && (
      <a
        href={link.url}
        target="_blank"
        rel="noopener noreferrer"
        class="project-link project-link-primary"
      >
        <svg width="13" height="13" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 10 L10 4 M5 4h5v5"/>
        </svg>
        {link.name}
      </a>
    )}
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #ffffff;
    border: 1px solid #e5e5e5;
    padding: 1.4rem 1.5rem 1.25rem;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  /* Accent rule draws across the top edge on hover. Sits at -1px so it covers
     the card's own border rather than stacking on top of it. */
  .project-card::before {
    content: "";
    position: absolute;
    top: -1px;
    left: -1px;
    height: 2px;
    width: 0;
    background: var(--color-accent-500);
    transition: width 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .project-card:hover,
  .project-card:focus-within {
    border-color: var(--color-accent-300);
    box-shadow: 0 8px 20px -10px rgba(23, 23, 23, 0.22);
    transform: translateY(-2px);
  }
  .project-card:hover::before,
  .project-card:focus-within::before {
    width: calc(100% + 2px);
  }

  .project-card-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.55rem;
  }
  .project-index {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--color-accent-600);
  }
  .project-live {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--color-accent-600);
  }
  .project-live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent-500);
    box-shadow: 0 0 0 0 rgba(61, 139, 95, 0.5);
    animation: livePulse 2.4s ease-out infinite;
  }
  @keyframes livePulse {
    0% { box-shadow: 0 0 0 0 rgba(61, 139, 95, 0.5); }
    70% { box-shadow: 0 0 0 5px rgba(61, 139, 95, 0); }
    100% { box-shadow: 0 0 0 0 rgba(61, 139, 95, 0); }
  }

  .project-title {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: #171717;
    transition: color 0.2s;
  }
  .project-card:hover .project-title,
  .project-card:focus-within .project-title {
    color: var(--color-accent-700);
  }

  .project-desc {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.65;
    color: #525252;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.4rem;
    margin: 0.95rem 0 0;
    padding: 0;
    list-style: none;
  }
  .project-tag {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.66rem;
    letter-spacing: 0.01em;
    color: #525252;
    background: #f5f5f5;
    border: 1px solid #ededed;
    padding: 0.16rem 0.5rem;
  }

  /* margin-top: auto pins the links to the bottom so rows of unequal-length
     descriptions still line their links up. */
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    margin-top: auto;
    padding-top: 1.1rem;
  }
  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: #737373;
    text-decoration: none;
    transition: color 0.2s;
  }
  .project-link:hover {
    color: var(--color-accent-700);
  }
  .project-link-primary {
    color: var(--color-accent-600);
  }
  .project-link svg {
    transition: transform 0.2s;
  }
  .project-link-primary:hover svg {
    transform: translate(2px, -2px);
  }

  /* Stagger the entrance. Set as a custom property rather than an inline
     animation-delay because the nav script resets el.style.animation to
     retrigger these, which would wipe an inline delay.

     backwards, not both: a filled animation wins over normal declarations, so
     the fadeUp end keyframe's translateY(0) would beat the :hover lift below
     and the card would never move. backwards still covers the stagger delay. */
  .project-card.fade-up {
    animation-delay: var(--stagger, 0s);
    animation-fill-mode: backwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card::before,
    .project-link svg {
      transition: none;
    }
    .project-card:hover,
    .project-card:focus-within {
      transform: none;
    }
    .project-live-dot {
      animation: none;
    }
  }
</style>
