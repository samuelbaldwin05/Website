# PostHog. Copy to .env for local dev, and set the same vars in Netlify's
# build environment. Analytics is skipped entirely when the key is unset.
PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# US cloud: https://us.i.posthog.com   EU cloud: https://eu.i.posthog.com
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
